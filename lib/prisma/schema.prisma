generator client {
  provider = "prisma-client-js"
  output   = "../../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model PG {
  id               String     @id @default(uuid())
  name             String
  upiId            String     // The landlord's UPI ID
  address          String?    // The full address of the PG
  phone            String?    // The primary contact number for the PG
  ownerId          String     // Your auth system user ID
  
  // Billing Engine
  billingCycleDate Int        @default(1)  
  rentDueDate      Int        @default(0)  
  dailyLateFee     Float      @default(0) 
  
  tenants          Tenant[]
  invoices         Invoice[]  
  roomTypes        RoomType[]
  roomUnits        RoomUnit[] 
  expenses         Expense[]
  incomes          Income[]
}

model Invoice {
  id              String   @id @default(uuid())
  billingMonth    String   // e.g., "August 2026"
  baseRent        Float
  accumulatedFine Float    @default(0) 
  totalAmount     Float    // baseRent + accumulatedFine
  amountPaid      Float    @default(0) 
  
  status          PaymentStatus   @default(PENDING)
  dueDate         DateTime 

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  pgId            String
  pg              PG       @relation(fields: [pgId], references: [id])

  transactions    Transaction[] 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(uuid())
  amount        Float    
  paymentMethod String   // UPI, CASH, BANK TRANSFER
  dateReceived  DateTime @default(now())
  referenceId   String?  // Optional: For UPI Transaction IDs

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model RoomType {
  id        String     @id @default(uuid())   
  name      String     // e.g., "2-Sharing Non-AC"
  price     Float
  capacity  Int        @default(2)   
  
  pgId      String
  pg        PG         @relation(fields: [pgId], references: [id], onDelete: Cascade)
  
  units     RoomUnit[]
}

model RoomUnit {
  id         String    @id @default(uuid())
  roomNumber String    
  
  roomTypeId String    
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  pgId       String    // SAAS FIX: Direct link to PG
  pg         PG        @relation(fields: [pgId], references: [id], onDelete: Cascade)

  tenants    Tenant[]  
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Tenant {
  id             String    @id @default(uuid())
  name           String
  phone          String
  alternatePhone String?
  email          String?  
  rent           Float
  
  pgId           String
  pg             PG        @relation(fields: [pgId], references: [id])
  
  roomId         String?   
  room           RoomUnit? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  securityDeposit Float    @default(0)

  
  invoices       Invoice[] // Linked to the new billing engine

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  month       String   // e.g., "August 2026" — matches billingMonth format
  category    String   // "Electricity", "Internet", "Staff", "Maintenance", "Other"
  amount      Float
  note        String?

  pgId        String
  pg          PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Income {
  id          String   @id @default(uuid())
  month       String   // e.g., "August 2026" — matches billingMonth format
  category    String   // "Fine", "Laundry", "Food/Meals", "Vending Machine", "Other"
  amount      Float
  note        String?

  pgId        String
  pg          PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

